json.txt

# Local Claude Code / Supabase CLI tooling state -- not project source
.claude/
supabase/.temp/

# Ad hoc analysis/audit output (health-audit finding 7.7) -- knip-report.txt,
# card-source-audit.json, and various one-off *-inventory.txt/*-manifest.csv
# exports were repeatedly committed to the repo root over past releases,
# never referenced by anything, and went stale (one committed knip-report.txt
# described files that had already been deleted). These are regenerable
# analysis output, not source -- keep them local instead of committing them.
knip-report.txt
card-source-audit.json
*-inventory.txt
*-manifest.csv

